# Copy to .env.local for `npm run dev`. Production values are injected by infrastructure/scripts/deploy_web.sh.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# dev only: where /api/* is proxied (the deployed API Gateway stage URL)
DEV_API_PROXY_TARGET=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/v1
