# Part 1 (Inbox Reviewer) settings. The deployed Lambdas get these from CDK (infrastructure/inbox_automation.py);
# this file is for local runs (`python -m inbox.cli ...`) and the tests. It contains NO secrets: tokens live in AWS Secrets Manager.

# Which integrations are real. "sample" = clearly labelled test adapters (fixture mailbox / in-memory tasks).
OUTLOOK_MODE=sample          # sample | graph  (graph needs the Microsoft Graph connection, see README)
CLICKUP_MODE=sample          # sample | api    (api reads the secret below and writes to the real list)

INBOX_MAILBOX=xpand@medgan.ai
CLICKUP_SECRET_ID=xpand/inbox/clickup     # JSON {"token": "...", "team_id": "...", "list_id": "..."}  set with infrastructure/scripts/configure_clickup.sh
GRAPH_SECRET_ID=xpand/inbox/graph         # JSON {"tenant_id", "client_id", "refresh_token"}           set with infrastructure/scripts/connect_outlook.sh

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Deployed-only (output by `cdk deploy`): the DynamoDB table, the agent runtime and the gateway
# INBOX_TABLE=xpand-inbox-state
# INBOX_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:<account>:runtime/inbox_reviewer_agent-<id>
# INBOX_GATEWAY_URL=https://<gateway-id>.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp

# Policy (explicit, reviewable defaults; the model never decides these)
INBOX_DEFAULT_PRIORITY=normal   # the only value filled in on the agent's behalf; empty = leave priority unset
INBOX_DEFAULT_STATUS=to do      # ClickUp gives new tasks the list's FIRST status ("blocked" here), so a new task gets this explicit status
INBOX_AUTO_SEND_REPLIES=false   # true allows automatic replies to INTERNAL senders only; external or sensitive replies always need approval
INBOX_MIN_CONFIDENCE=0.7
INBOX_DUPLICATE_HIGH=0.8        # at or above: the same work as an existing task
INBOX_DUPLICATE_LOW=0.5         # between low and high: a person decides
INBOX_INTERNAL_DOMAINS=medgan.ai
INBOX_REVIEWER_GROUP=inbox-reviewers
