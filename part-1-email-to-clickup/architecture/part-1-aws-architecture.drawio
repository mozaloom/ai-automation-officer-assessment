ices where practical" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontFamily=Helvetica;spacing=0;spacingTop=0;spacing=4;" vertex="1" parent="1"><mxGeometry x="1316" y="992" width="610" height="280" as="geometry"/></mxCell><mxCell id="sec-sec" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=light-dark(#DD344C0D,#DD344C0D);strokeColor=#DD344C;strokeWidth=1.5;dashed=1;fillStyle=auto;container=0;pointerEvents=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="1320" width="1610" height="160" as="geometry"/></mxCell><mxCell id="sec-t" value="AWS Security · cross-cutting layer (applies to all components, no per-service arrows)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontFamily=Helvetica;spacing=0;spacingTop=0;fontColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="360" y="1324" width="900" height="18" as="geometry"/></mxCell><mxCell id="c-iam" value="Access control" style="fillColor=#FFEBEE;strokeColor=#DD344C;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#DD344C;fontFamily=Helvetica;container=1;collapsible=0;shadow=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="370" y="1348" width="120" height="120" as="geometry"/></mxCell><mxCell id="svc-iam" value="AWS IAM" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fontFamily=Helvetica;shadow=1;" vertex="1" parent="c-iam"><mxGeometry x="36" y="30" width="48" height="48" as="geometry"/></mx