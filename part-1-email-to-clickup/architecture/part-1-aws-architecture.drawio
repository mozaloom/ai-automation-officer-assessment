yle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="192" y="1130" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-12" value="12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1270" y="866" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-13" value="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="852" y="355" width="28" height="28" as="geometry"/></mxCell><mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2340" y="30" width="560" height="1480" as="geometry"/></mxCell><mxCell id="legend-container" value="" style="group" vertex="1" connectable="0" parent="1"><mxGeometry x="2360" y="50" width="520" height="1440" as="geometry"/></mxCell><mxCell id="step-1-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="0" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-1-badge-legend" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-1-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-1-desc-legend" value="&lt;div&gt;&lt;b&gt;Webhook notification&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Outlook, through Microsoft Graph, pushes a change notification to the API Gateway endpoint. API Gateway only receives it; it never reads the mailbox.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-1-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-2-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="100" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-2-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;Ingestion&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;API Gateway invokes the ingestion Lambda, which validates the notification and fetches the full email (sender, subject, body, attachments, thread, timestamp).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-2-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-3-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="200" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-3-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;Idempotency check&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Lambda checks and records the Message ID in DynamoDB so the same email never creates a duplicate task.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-4-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="300" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-4-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;Async events&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Lambda emits email-processing events to EventBridge (optional asynchronous backbone).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-4-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-5-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="400" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-5-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-5-desc-legend" value="&lt;div&gt;&lt;b&gt;Invoke agent&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Lambda calls the Strands Inbox Reviewer Agent hosted on AgentCore Runtime.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-5-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-6-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="500" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-6-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-6-desc-legend" value="&lt;div&gt;&lt;b&gt;LLM reasoning&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The agent calls Amazon Bedrock Nova 2 Lite to classify intent, extract task fields and check for duplicates.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-6-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-7-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="600" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-7-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-7-desc-legend" value="&lt;div&gt;&lt;b&gt;Act through MCP&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CREATE_TASK, UPDATE_TASK and REPLY are executed as MCP tool calls through AgentCore Gateway. IGNORE takes no action.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-7-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-8-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="700" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-8-badge-legend" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-8-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-8-desc-legend" value="&lt;div&gt;&lt;b&gt;ClickUp tools&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;ClickUp MCP exposes search_tasks, create_task and update_task against ClickUp.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-8-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-9-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="800" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-9-badge-legend" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-9-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-9-desc-legend" value="&lt;div&gt;&lt;b&gt;Outlook reply&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Outlook MCP exposes reply_to_email to answer the sender in the original thread.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-9-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-10-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="900" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-10-badge-legend" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-10-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-10-desc-legend" value="&lt;div&gt;&lt;b&gt;Escalate (exception)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;HUMAN_REVIEW is used only for ambiguity, missing information, possible duplicates or higher-risk actions.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-10-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-11-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="1000" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-11-badge-legend" value="11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-11-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-11-desc-legend" value="&lt;div&gt;&lt;b&gt;Admin portal (optional)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A reviewer signs in with Cognito, uses the Amplify app and API Gateway to approve, edit or reject the proposal.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-11-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-12-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="1100" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-12-badge-legend" value="12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-12-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-12-desc-legend" value="&lt;div&gt;&lt;b&gt;Resume&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The human decision returns to the agent and execution continues through Gateway and MCP.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-12-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="step-13-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry x="0" y="1200" width="520" height="90" as="geometry"/></mxCell><mxCell id="step-13-badge-legend" value="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-13-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-13-desc-legend" value="&lt;div&gt;&lt;b&gt;Observability&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;AgentCore Observability sends traces, LLM, tool and MCP calls, latency and errors to CloudWatch.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-13-legend"><mxGeometry x="52" y="0" width="466" height="90" as="geometry"/></mxCell><mxCell id="legend-lines" value="" style="rounded=0;html=1;fontFamily=Helvetica;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="2360" y="1370" width="520" height="125" as="geometry"/></mxCell><mxCell id="legend-lines-text" value="&lt;div&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Solid arrow: synchronous call / data flow&lt;br&gt;Dashed arrow: asynchronous events and telemetry&lt;br&gt;Orange container: human-in-the-loop exception path&lt;br&gt;Red dashed container: optional admin portal&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2374" y="1380" width="492" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>